  },
  "oracle": "private perfect-information ceiling (headroom only; not a comparator)"
 },
 "comparisons": {
  "B2": {
   "method": "meta-complete",
   "comparators": [
    "independent",
    "hybrid"
   ],
   "rule": "supported only if, against EACH comparator: 95% cluster-bootstrap interval of the mean paired S difference excludes zero, the mean gain is >= 0.5 pp, the relative essential-deficit reduction is >= 10%, and no service group regresses by more than 0.5 pp on average"
  },
  "B1": {
   "method": "hybrid (forecast-guided)",
   "comparator": "independent (reactive)",
   "population": "families with an observable threat: developing-threat",
   "rule": "same thresholds on the anticipatory population; warning must precede loss by more than the execution time",
   "note": "two anticipatory groups only: at most exploratory"
  },
  "B5": {
   "scope": "no-fault and disturbance strata of this suite",
   "rule": "per-critical-group S regression lower bound above -0.5 pp for meta-complete vs hybrid; local control continues; no stale action executes"
  }
 },
 "inference": {
  "unit": "scenario group",
  "bootstrap": {
   "reps": 5000,
   "seed": 20261103,
   "clusters": "family"
  },
  "multiplicity": "B2 is primary; B1 and B5 are secondary and reported separately"
 },
 "precision": {
  "developmentPairedSdPp": 2,
  "groups": 16,
  "ci95HalfWidthPp": 1,
  "mdePp80": 1.4,
  "statement": "Development paired S differences (hybrid - independent, 5 cases) have SD 2.0 pp. With 16 groups the 95% half-width is about 1.0 pp and the 80%-power minimum detectable effect about 1.4 pp: a true effect between 0.5 and 1.4 pp would likely be inconclusive."
 },
 "order": {
  "seed": 20261104,
  "rule": "controller order randomized within each group"
 },
 "budget": {
  "metaCallsMax": 96,
  "metaOutputTokensMax": 576000,
  "wallHoursEstimate": 4
 },
